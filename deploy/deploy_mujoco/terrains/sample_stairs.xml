  <default>
    <!-- 动力学可调项：wood 密度按实测总质量同比例调整；metal 为铝方管等效密度（非实心铝）。几何板厚为视频估计。接触参数控制柔度/耗散；禁止用 freejoint damping 强行把模块拉回原位。 -->
    <default class="wood">
      <geom type="box" group="0" contype="1" conaffinity="1" density="500" friction=".9 .005 .0001" condim="4" solref=".015 1" solimp=".9 .95 .001" rgba=".68 .52 .34 1" />
    </default>
    <default class="metal">
      <geom type="box" group="0" contype="1" conaffinity="1" density="300" friction=".9 .005 .0001" condim="4" solref=".015 1" solimp=".9 .95 .001" rgba=".65 .68 .7 1" />
    </default>
    <default class="white_leg_flex">
      <!-- 等效支腿弯曲/连接松度：每腿两个正交被动铰链。
           stiffness 单位 N*m/rad，damping 单位 N*m*s/rad，range 单位 rad。
           降 stiffness 会增大摆幅，降 damping 会延长回摆；此处未实物标定。
           2026-10-23 用户确认没有测量值，采用当前工程估计为默认参数。
           视频用于判断外形与摆放比例；柔度按几厘米级受力侧摆选取。
           小角度横向刚度近似为四腿关节刚度之和除以支腿长度平方；
           台面竖向载荷还会通过几何效应降低侧向刚度。
           实际响应由载荷、接触和此处关节参数共同决定，未指定固定摆幅。
           弹簧只作用在腿与台面之间，整个平台仍能受力移动。 -->
      <joint type="hinge" limited="true" range="-.25 .25" stiffness="60" damping="1.2" springref="0" solreflimit=".02 1" />
    </default>
  </default>
