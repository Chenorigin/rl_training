<!-- 全地形连续测试路线，使用原生 MJCF 碰撞几何，不依赖生成器或外部资产。
     部署入口：deploy_mujoco.py 的 terrain-xml 参数；本文件不含机器人。
     单位：长度 m，角度注释为度；世界 +X 前进、+Y 左、+Z 上。
     统计路线宽 4m，出生 (-1,0)，终点 X=38m；路线外仍有 z=0 平地，便于遥控。
     路线顺序与 X 范围：
       起步平地至 1 -> 上楼 1~2.8 -> 平台 2.8~4.8 -> 下楼 4.8~6.6
       -> 缓冲 6.6~8 -> 上坡 8~11 -> 坡顶 11~12.5 -> 下坡 12.5~15.5
       -> 缓冲 15.5~17 -> 粗糙方块 17~20 -> 缓冲 20~21
       -> 错位障碍 21~24 -> 缓冲 24~25 -> 障碍条 25~27.22
       -> 缓冲至 29 -> 横坡 29~32 -> 缓冲 32~34
       -> 低摩擦区 34~36 -> 终点平地 36~39。
     平地缓冲用于恢复姿态，也可测试停车、倒退、侧移和转向。

     调参方式：直接编辑本段 geom 的 pos、size、quat、friction 后重启。
       box 的 pos 是中心，size 是半尺寸；未旋转方块顶高=pos_z+size_z。
       改统一阶高要同步全部台阶和平台：第 i 阶 pos_z=size_z=i*h/2。
       修改坡角要同步坡盒 quat、中心、size 和顶部平台，公式见坡段注释。
       custom/numeric 中只有部署元数据，不驱动下面几何；不存在隐藏的生成参数。
       所有碰撞几何继承 group=0，187点高程扫描能读取实际顶面。
       不支持用单类楼梯的命令行参数覆盖本文件；请修改 XML。
     注意：终点越线不检查绕行，不代表每段通过；应观察整条轨迹。
-->
<mujoco model="m20_all_terrain">
  <compiler angle="radian"/>
  <custom>
    <text name="terrain_kind" data="custom"/>
    <!-- width 用于统计范围；修改它不会自动改变各碰撞体的宽度。 -->
    <numeric name="width" data="4.0"/>
    <!-- friction 供加载器补地面时使用；已有地面的实际摩擦由下面 default 定义。 -->
    <numeric name="friction" data="1.0 0.01 0.01"/>
    <numeric name="spawn_xy" data="-1.0 0.0"/>
    <numeric name="spawn_yaw_deg" data="0"/>
    <!-- 修改路线总长度时同步统计终点；终点后保留 1m 以上空间。 -->
    <numeric name="goal_x" data="38.0"/>
  </custom>
  <default>
    <!-- 地面/障碍公共接触参数：滑动、扭转、滚动摩擦；局部可覆盖。 -->
    <default class="all_terrain_surface">
      <geom type="box" group="0" contype="1" conaffinity="1" condim="3"
            friction="1.0 0.01 0.01" rgba="0.52 0.57 0.63 1"/>
    </default>
  </default>
  <worldbody>
    <geom name="base_floor" class="all_terrain_surface" type="plane"
          pos="0 0 0" size="100 100 0.1" rgba="0.31 0.35 0.38 1"/>
    <!-- 01 上楼：6阶，阶高0.15，踏深0.30，宽4；每阶从地面实心填充。 -->
    <geom name="ascent_step_01" class="all_terrain_surface" pos="1.15 0 0.075" size="0.15 2 0.075" rgba="0.42 0.56 0.72 1"/>
    <geom name="ascent_step_02" class="all_terrain_surface" pos="1.45 0 0.15" size="0.15 2 0.15" rgba="0.42 0.56 0.72 1"/>
    <geom name="ascent_step_03" class="all_terrain_surface" pos="1.75 0 0.225" size="0.15 2 0.225" rgba="0.42 0.56 0.72 1"/>
    <geom name="ascent_step_04" class="all_terrain_surface" pos="2.05 0 0.3" size="0.15 2 0.3" rgba="0.42 0.56 0.72 1"/>
    <geom name="ascent_step_05" class="all_terrain_surface" pos="2.35 0 0.375" size="0.15 2 0.375" rgba="0.42 0.56 0.72 1"/>
    <geom name="ascent_step_06" class="all_terrain_surface" pos="2.65 0 0.45" size="0.15 2 0.45" rgba="0.42 0.56 0.72 1"/>
    <!-- 02 楼顶平台：X=[2.8,4.8]，长2，顶高0.9，宽4。 -->
    <geom name="stair_top_platform" class="all_terrain_surface" pos="3.8 0 0.45" size="1 2 0.45" rgba="0.38 0.48 0.60 1"/>
    <!-- 03 下楼：6次下降，各0.15，踏深0.30；第6级回到底部平面，无重复零厚盒。 -->
    <geom name="descent_step_01" class="all_terrain_surface" pos="4.95 0 0.375" size="0.15 2 0.375" rgba="0.50 0.61 0.72 1"/>
    <geom name="descent_step_02" class="all_terrain_surface" pos="5.25 0 0.3" size="0.15 2 0.3" rgba="0.50 0.61 0.72 1"/>
    <geom name="descent_step_03" class="all_terrain_surface" pos="5.55 0 0.225" size="0.15 2 0.225" rgba="0.50 0.61 0.72 1"/>
    <geom name="descent_step_04" class="all_terrain_surface" pos="5.85 0 0.15" size="0.15 2 0.15" rgba="0.50 0.61 0.72 1"/>
    <geom name="descent_step_05" class="all_terrain_surface" pos="6.15 0 0.075" size="0.15 2 0.075" rgba="0.50 0.61 0.72 1"/>
    <!-- 04 上下坡：每段水平长3，坡角12度，法向厚0.15，宽4；坡顶高3*tan(12度)=0.637669685，平台长1.5。
         设theta=atan2(z1-z0,L),t为法向厚：
         quat=[cos(theta/2),0,-sin(theta/2),0]；size=[hypot(L,z1-z0)/2,width/2,t/2]；
         pos=[start+L/2+sin(theta)*t/2,0,(z0+z1)/2-cos(theta)*t/2]。
         按此公式计算，顶面端点分别是(start,z0)、(start+L,z1)，不把盒中心当顶面。 -->
    <geom name="ramp_ascent" class="all_terrain_surface" pos="9.515593377 0 0.245473772" size="1.533510892 2 0.075" quat="0.994521895 0 -0.104528463 0" rgba="0.42 0.58 0.40 1"/>
    <geom name="ramp_top_platform" class="all_terrain_surface" pos="11.75 0 0.318834843" size="0.75 2 0.318834843" rgba="0.35 0.50 0.34 1"/>
    <geom name="ramp_descent" class="all_terrain_surface" pos="13.984406623 0 0.245473772" size="1.533510892 2 0.075" quat="0.994521895 0 0.104528463 0" rgba="0.42 0.58 0.40 1"/>
