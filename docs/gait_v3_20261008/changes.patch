+        dist = (delta * state["map_heading"]).sum(-1)
+        cross = (delta[..., 0] * state["map_heading"][..., 1]
+                 - delta[..., 1] * state["map_heading"][..., 0]).abs()
+        known = torch.arange(64, device=device)[None] < state["map_count"][:, None]
